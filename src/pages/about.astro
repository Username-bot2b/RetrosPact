---
import Layout from '~/layouts/PageLayout.astro';
import RetroWindow from '~/components/ui/RetroWindow.astro';
import RetroTabs from '~/components/ui/RetroTabs.astro';
import RetroStatusBar from '~/components/ui/RetroStatusBar.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'About',
};

const tabs = [
  { id: 'overview', label: 'Overview' },
  { id: 'currently', label: 'Currently' },
  { id: 'elsewhere', label: 'Elsewhere' },
  { id: 'more', label: 'More' },
];
---

<Layout metadata={metadata}>
  <section class="bg-retro py-3 md:py-4">
    <div class="max-w-5xl mx-auto px-4">
      <RetroWindow title="About" icon="app-user-settings" flush clientClass="p-0">
        <RetroTabs tabs={tabs} initial="overview" label="About sections">
          <div data-tab-panel="overview">
            <h1 class="retro-h1">About me</h1>
            <p class="retro-lede m-0">
              This is a personal website. Replace this text with a short introduction — who you are, what you work on,
              and what visitors can expect to find here.
            </p>
          </div>

          <div data-tab-panel="currently" hidden>
            <div class="retro-groupbox mt-1 mb-0">
              <span class="retro-groupbox__label">Currently</span>
              <p class="retro-text m-0">
                Writing, building small tools, and tinkering with retro-inspired interfaces.
              </p>
            </div>
          </div>

          <div data-tab-panel="elsewhere" hidden>
            <div class="retro-groupbox mt-1 mb-0">
              <span class="retro-groupbox__label">Elsewhere</span>
              <p class="retro-text m-0">
                Add links to GitHub, social profiles, or a resume when you're ready.
              </p>
            </div>
          </div>

          <div data-tab-panel="more" hidden>
            <p class="retro-text mb-3">
              Browse the blog for notes and experiments, or send a message if you want to get in touch.
            </p>
            <div class="flex flex-wrap gap-2">
              <a href={getPermalink('/contact')} class="btn-retro-primary">Get in touch</a>
              <a href={getPermalink('/blog')} class="btn-retro">Blog</a>
            </div>
          </div>
        </RetroTabs>

        <RetroStatusBar slot="statusbar" label="About status">
          <div class="retro-statusbar__pane retro-statusbar__pane--grow">Ready.</div>
          <div class="retro-statusbar__pane">Tabs: {tabs.length}</div>
          <div class="retro-statusbar__pane">About</div>
        </RetroStatusBar>
      </RetroWindow>
    </div>
  </section>
</Layout>
