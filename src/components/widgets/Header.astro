---
import RetroIcon from '~/components/ui/RetroIcon.astro';
import MnemonicLabel from '~/components/ui/MnemonicLabel.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import { SITE } from '~/config';

import { trimSlash } from '~/utils/permalinks';
import { resolveMnemonic } from '~/utils/mnemonic';
import { isSerenityIcon } from '~/assets/icons/serenity';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  /** Optional mnemonic letter (defaults to first unused A–Z in text) */
  mnemonic?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const windowTitle = SITE?.name || 'RetrosPact';

const usedMnemonics = new Set<string>();
const menuItems = links.map((link) => {
  const mnemonic = resolveMnemonic(link.text ?? '', link.mnemonic, usedMnemonics);
  return { ...link, mnemonic };
});
---

<header
  class:list={[
    'top-0 z-40 flex-none mx-auto w-full',
    { sticky: isSticky, relative: !isSticky },
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="retro-window">
    <div class="retro-title-bar">
      <span class="retro-title-bar__icon" aria-hidden="true">
        <RetroIcon name="app-browser" width={14} height={14} />
      </span>
      <span class="retro-title-bar__text">{windowTitle}</span>
      <span class="retro-title-bar__stripes" aria-hidden="true"></span>
      <div class="retro-title-bar__controls" aria-hidden="true">
        <span class="retro-title-btn">
          <span class="retro-title-btn__glyph retro-title-btn__glyph--min"></span>
        </span>
        <span class="retro-title-btn">
          <span class="retro-title-btn__glyph retro-title-btn__glyph--max"></span>
        </span>
        <span class="retro-title-btn">
          <span class="retro-title-btn__glyph retro-title-btn__glyph--close"></span>
        </span>
      </div>
    </div>

    <div class="retro-menubar">
      {/*
        Single #header nav — BasicScripts toggles `.hidden` for mobile.
        Desktop: horizontal classic menu bar. Mobile (expanded): stacked list.
      */}
      <nav class="hidden md:block min-w-0 flex-1" aria-label="Main navigation">
        {/* Desktop menu bar */}
        <ul class="retro-menubar__menus !hidden md:!flex">
          {
            menuItems.map(({ text, href, links: childLinks, icon, mnemonic }) => (
              <li class={childLinks?.length ? 'dropdown relative' : ''}>
                {childLinks?.length ? (
                  <>
                    <button type="button" class="retro-menu-top" accesskey={mnemonic || undefined}>
                      {icon && isSerenityIcon(icon) && (
                        <RetroIcon name={icon} class="retro-menu-item__icon" />
                      )}
                      <span>
                        <MnemonicLabel text={text ?? ''} mnemonic={mnemonic} />
                      </span>
                      <span class="retro-menu-top__caret" aria-hidden="true">
                        ▾
                      </span>
                    </button>
                    <ul class="retro-dropdown">
                      {childLinks.map(({ text: text2, href: href2, icon: icon2 }) => (
                        <li>
                          <a
                            class:list={['retro-menu-item', { 'is-active': href2 === currentPath }]}
                            href={href2}
                          >
                            {icon2 && isSerenityIcon(icon2) && (
                              <RetroIcon name={icon2} class="retro-menu-item__icon" />
                            )}
                            {text2}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a
                    class:list={['retro-menu-top', { 'is-current': href === currentPath }]}
                    href={href}
                    accesskey={mnemonic || undefined}
                  >
                    {icon && isSerenityIcon(icon) && (
                      <RetroIcon name={icon} class="retro-menu-item__icon" />
                    )}
                    <span>
                      <MnemonicLabel text={text ?? ''} mnemonic={mnemonic} />
                    </span>
                  </a>
                )}
              </li>
            ))
          }
        </ul>

        {/* Mobile accordion list */}
        <ul class="retro-list m-0 md:!hidden">
          {
            menuItems.map(({ text, href, links: childLinks, icon }) => (
              <li class="retro-list-item">
                {childLinks?.length ? (
                  <details>
                    <summary class="retro-text">
                      {icon && isSerenityIcon(icon) && (
                        <RetroIcon
                          name={icon}
                          class="retro-menu-item__icon inline-block align-middle mr-1"
                        />
                      )}
                      {text}
                    </summary>
                    <div class="flex flex-col p-0">
                      {childLinks.map(({ text: text2, href: href2 }) => (
                        <a class="retro-menu-item" href={href2}>
                          {text2}
                        </a>
                      ))}
                    </div>
                  </details>
                ) : (
                  <a class="retro-menu-item" href={href}>
                    {icon && isSerenityIcon(icon) && (
                      <RetroIcon name={icon} class="retro-menu-item__icon" />
                    )}
                    {text}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="retro-menubar__actions ml-auto">
        {
          actions?.length
            ? actions.map(({ text, href, target }) => (
                <a
                  class="btn-retro-primary hidden sm:inline-flex"
                  href={href}
                  {...(target ? { target, rel: 'noopener noreferrer' } : {})}
                >
                  {text}
                </a>
              ))
            : null
        }
        <div class="flex md:hidden">
          <ToggleMenu />
        </div>
      </div>
    </div>
  </div>
</header>
