---
import { APP_BLOG } from '~/config';
import type { Post } from '~/types';
import { getPermalink } from '~/utils/permalinks';
import Image from '~/components/common/Image.astro';
import { findImage } from '~/utils/images';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
const image = await findImage(post.image);
---

<article class="retro-panel">
  <div class="flex gap-2">
    {
      image && (
        <div class="flex-shrink-0 retro-inset self-start bg-[var(--retro-base)]">
          {link ? (
            <a href={link}>
              <Image
                src={image}
                class="w-20 h-20 object-cover block"
                width={80}
                height={80}
                alt={post.title}
                loading="lazy"
                decoding="async"
              />
            </a>
          ) : (
            <Image
              src={image}
              class="w-20 h-20 object-cover block"
              width={80}
              height={80}
              alt={post.title}
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
      )
    }
    <div class="flex-1 min-w-0">
      <h3 class="retro-h3">
        {
          link ? (
            <a class="hover:underline" href={link}>
              {post.title}
            </a>
          ) : (
            post.title
          )
        }
      </h3>
      <p class="retro-caption mb-0">{post.excerpt}</p>
    </div>
  </div>
</article>
