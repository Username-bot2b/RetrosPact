---
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
}

const { prevUrl, nextUrl, prevText = '← Newer', nextText = 'Older →' } = Astro.props;
---

{
  (prevUrl || nextUrl) && (
    <div class="flex justify-between items-center gap-3 mt-6 p-2 bg-[var(--retro-face)] retro-raised">
      {prevUrl ? (
        <a href={getPermalink(prevUrl)} class="btn-retro">
          {prevText}
        </a>
      ) : (
        <span class="btn-retro is-disabled">{prevText}</span>
      )}

      {nextUrl ? (
        <a href={getPermalink(nextUrl)} class="btn-retro">
          {nextText}
        </a>
      ) : (
        <span class="btn-retro is-disabled">{nextText}</span>
      )}
    </div>
  )
}
