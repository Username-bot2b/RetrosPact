---
import { getPermalink } from '~/utils/permalinks';

import { APP_BLOG } from '~/config';
import type { Post } from '~/types';

export interface Props {
  tags: Post['tags'];
  class?: string;
  title?: string | undefined;
  isCategory?: boolean;
}

const { tags, class: className = '', title = undefined, isCategory = false } = Astro.props;
---

{
  tags && Array.isArray(tags) && tags.length > 0 && (
    <div class:list={['flex flex-wrap items-center gap-2', className]}>
      {title !== undefined && <span class="retro-label">{title}:</span>}
      <ul class="flex flex-wrap gap-1 m-0 p-0 list-none">
        {tags.map((tag) => (
          <li>
            {!APP_BLOG?.tag?.isEnabled ? (
              <span class="btn-retro !min-h-0 !px-2 !py-0.5 !text-[11px]">{tag.title}</span>
            ) : (
              <a href={getPermalink(tag.slug, isCategory ? 'category' : 'tag')} class="btn-retro !min-h-0 !px-2 !py-0.5 !text-[11px]">
                {tag.title}
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  )
}
